# Copy this file to .env.local for local development, and add the same vars to
# GitHub Actions repo secrets (Settings → Secrets and variables → Actions) for
# the deployed site. Values come from your Firebase web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of Google sign-in emails allowed into /admin.
# Example: ext_arbaz.hanif@astratech.ae,arbazpirwani@gmail.com
VITE_ADMIN_EMAILS=ext_arbaz.hanif@astratech.ae
